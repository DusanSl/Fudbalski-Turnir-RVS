@model PrezentacioniSloj.PrezentacionaLogika.ViewModels.RegistracijaViewModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h2 class="text-center mb-4">Registracija</h2>

        <form asp-action="Registracija" asp-controller="Nalog" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="KorisnickoIme" class="form-label">Korisničko ime</label>
                <input asp-for="KorisnickoIme" class="form-control" placeholder="Unesite korisničko ime" />
                <span asp-validation-for="KorisnickoIme" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Lozinka" class="form-label">Lozinka</label>
                <input asp-for="Lozinka" class="form-control" placeholder="Unesite lozinku" />
                <span asp-validation-for="Lozinka" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PotvrdaLozinke" class="form-label">Potvrda lozinke</label>
                <input asp-for="PotvrdaLozinke" class="form-control" placeholder="Ponovite lozinku" />
                <span asp-validation-for="PotvrdaLozinke" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Registruj se</button>
            <div class="text-center mt-3">
                <a asp-action="Prijava" asp-controller="Nalog">Već imate nalog? Prijavite se</a>
            </div>
        </form>
    </div>
</div>