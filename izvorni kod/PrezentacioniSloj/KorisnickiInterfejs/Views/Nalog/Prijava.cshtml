@model PrezentacioniSloj.PrezentacionaLogika.ViewModels.PrijavaViewModel

@{
    ViewData["Title"] = "Prijava";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h2 class="text-center mb-4">Prijava</h2>

        <form asp-action="Prijava" asp-controller="Nalog" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="KorisnickoIme" class="form-label">Korisničko ime</label>
                <input asp-for="KorisnickoIme" class="form-control" placeholder="Unesite korisničko ime" />
            </div>

            <div class="mb-3">
                <label asp-for="Lozinka" class="form-label">Lozinka</label>
                <input asp-for="Lozinka" class="form-control" placeholder="Unesite lozinku" />
            </div>

            <button type="submit" class="btn btn-primary w-100">Prijavi se</button>

            <div class="text-center mt-3">
                <a asp-action="Registracija" asp-controller="Nalog">Nemate nalog? Registrujte se</a>
            </div>

        </form>
    </div>
</div>