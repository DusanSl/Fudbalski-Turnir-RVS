@model List<SlojServisa.DTO.ZapisnikDTO>
@{
    ViewData["Title"] = "Štampa";
    bool jedanZapisnik = ViewBag.JedanZapisnik ?? false;
}

<div id="oblast-stampe">
    @if (jedanZapisnik && Model.Count == 1)
    {
        var z = Model.First();
        <div class="p-4">
            <h5 class="fw-bold text-uppercase">Zapisnik o odigranoj fudbalskoj utakmici (Br. @z.ZapisnikID)</h5>
            <hr />

            <h6 class="fw-bold text-uppercase mt-3">Podaci o lokaciji i terminu</h6>
            <table class="table table-borderless mb-0">
                <tr>
                    <td class="fw-bold p-1" style="width:180px">Teren/Stadion:</td>
                    <td class="p-1">@z.TerenNaziv</td>
                </tr>
                <tr>
                    <td class="fw-bold p-1">Mesto:</td>
                    <td class="p-1">@z.TerenMesto</td>
                </tr>
                <tr>
                    <td class="fw-bold p-1">Adresa:</td>
                    <td class="p-1">@z.TerenAdresa</td>
                </tr>
                <tr>
                    <td class="fw-bold p-1">Datum i vreme:</td>
                    <td class="p-1">@z.DatumUtakmice.ToString("dd/MM/yyyy") u @z.DatumUtakmice.ToString("HH:mm") časova</td>
                </tr>
            </table>

            <hr />
            <h6 class="fw-bold text-uppercase mt-3">Podaci o klubovima</h6>
            <p class="mb-1">
                <span class="fw-bold">DOMAĆIN:</span> @z.NazivDomacina
                &nbsp;&nbsp;&nbsp;
                <span class="fw-bold">GOST:</span> @z.NazivGosta
            </p>
            <p class="mb-1">
                <span class="fw-bold">KONAČAN REZULTAT:</span> [ @z.KonacanRezultatDomacin ] : [ @z.KonacanRezultatGost ]
            </p>

            <hr />
            <h6 class="fw-bold text-uppercase mt-3">Spisak postignutih golova</h6>
            @if (!z.Stavke.Any())
            {
                <p class="text-muted">Nema unetih golova.</p>
            }
            else
            {
                <table class="table table-bordered mt-2">
                    <thead>
                        <tr>
                            <th>Redni broj</th>
                            <th>Minut gola</th>
                            <th>Ime i prezime strelca</th>
                            <th>Klub (Domaćin/Gost)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int br = 1;
                        }
                        @foreach (var s in z.Stavke.OrderBy(s => s.MinutGola))
                        {
                            <tr>
                                <td>@br.</td>
                                <td>@s.MinutGola'</td>
                                <td>@s.ImeStrelca</td>
                                <td>@s.NazivKluba</td>
                            </tr>
                            br++;
                        }
                    </tbody>
                </table>
            }

        </div>
    }
    else
    {
        <h3 class="mb-4 text-center">Spisak zapisnika</h3>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Datum</th>
                    <th>Teren</th>
                    <th>Domaćin</th>
                    <th>Gost</th>
                    <th>Rezultat</th>
                    <th>Broj golova</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rbr = 1;
                }
                @foreach (var z in Model)
                {
                    <tr>
                        <td>@rbr</td>
                        <td>@z.DatumUtakmice.ToString("dd.MM.yyyy")</td>
                        <td>@z.TerenNaziv, @z.TerenMesto</td>
                        <td>@z.NazivDomacina</td>
                        <td>@z.NazivGosta</td>
                        <td class="fw-bold">@z.KonacanRezultatDomacin : @z.KonacanRezultatGost</td>
                        <td>@z.Stavke.Count</td>
                    </tr>
                    rbr++;
                }
            </tbody>
        </table>
    }
</div>

<div class="d-flex gap-2 mt-3 d-print-none">
    <button onclick="window.print()" class="btn btn-primary">Štampaj</button>
    <a asp-action="Spisak" class="btn btn-secondary">Nazad</a>
</div>